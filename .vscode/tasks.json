{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "前端: npm run dev",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}\\frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*VITE",
                    "endsPattern": "ready in|Local:"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "後端: mvnw spring-boot:run",
            "type": "shell",
            "command": ".\\mvnw.cmd spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting \\S+Application",
                    "endsPattern": "Started \\S+Application"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "start: 啟動開發環境 (前端+後端)",
            "dependsOrder": "parallel",
            "dependsOn": [
                "前端: npm run dev",
                "後端: mvnw spring-boot:run"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
