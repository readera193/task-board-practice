@baseUrl = http://localhost:8080

### Register

POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "username": "test",
  "password": "12345678"
}

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "test",
  "password": "12345678"
}

@token = {{login.response.body.accessToken}}

### Get all tasks
GET {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}


### Create task
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "學習 Spring Boot"
}


### Get task by id
GET {{baseUrl}}/api/tasks/1
Authorization: Bearer {{token}}


### Toggle task
PATCH {{baseUrl}}/api/tasks/1/toggle
Authorization: Bearer {{token}}


### Delete task
DELETE {{baseUrl}}/api/tasks/1
Authorization: Bearer {{token}}


### Get missing task
GET {{baseUrl}}/api/tasks/999
Authorization: Bearer {{token}}

### Invalid - blank title
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": ""
}

### Invalid - title
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": 
}


### Invalid - title too long
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

#### Invalid - task id
GET {{baseUrl}}/api/tasks/abc
Authorization: Bearer {{token}}

### Tasks
GET {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}

### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

